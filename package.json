{
  "name": "knowqore-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "biome check && markdownlint-cli2",
    "check:rust": "cargo test --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "check": "bun run lint && bun run build && bun run check:rust",
    "format": "biome check --write && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "astryx": "bun node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.3",
    "@astryxdesign/theme-neutral": "0.7.3",
    "@stylexjs/stylex": "0.19.1",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-opener": "2.7.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.3",
    "@biomejs/biome": "2.5.15",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "markdownlint-cli2": "0.23.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
